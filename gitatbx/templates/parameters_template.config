// Reference generic toolbox config
includeConfig '__TOOLBOX_DIR__/bin/nextflow.config'

// Git commit author configuration
params.git_user_name  = '__GIT_USER_NAME__'
params.git_user_email = '__GIT_USER_EMAIL__'

// -- Project parameters � pre-filled by atbx init -----------------------------
params.project_name  = '__PROJECT_NAME__'
params.input_dir     = '__INPUT_DIR__'
params.output_dir    = '__OUTPUT_DIR__'
params.python_exe    = '__PYTHON_EXE__'
params.toolbox_dir   = '__TOOLBOX_DIR__'
params.participant_pattern = '__PROJECT_NAME___*'
