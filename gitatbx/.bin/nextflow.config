// =========================================================================
// GENERAL TOOLBOX BASE CONFIGURATION
// Optimized for agnostics pipelines & multi-core local hosts
// =========================================================================

env {
    // Forces JVM/JNI native binary extraction into local launch dir instead of system /tmp
    JAVA_TOOL_OPTIONS = "-Djava.io.tmpdir=${launchDir}/.tmp"
}

process {
    // KLINISCH REINES TRIEBWERK: Fehlerfreie, rein deklarative Strategie
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'ignore' }
    maxRetries = 3
    
    // Backoff-Zeit vor jedem Retry, falls ein Netzlaufwerk kurz zuckt
    beforeScript = { task.attempt > 1 ? "sleep ${Math.pow(2, task.attempt - 1) as int}" : '' }

    // Dynamische Skalierung der System-Ressourcen pro Fehlversuch
    cpus   = 2
    memory = { 2.GB * task.attempt }

    // Copy-Modus garantiert Staging-Symmetrie auf Cross-OS Linux/WSL/NFS Mounts
    stageInMode  = 'copy'
    stageOutMode = 'copy'
}

executor {
    name   = 'local'
    cpus   = 16          // Passt sich an die realen Kerne Ihres Linux-Hosts an
    memory = 31.GB       // BEHOBEN: Natives MemoryUnit-Literal ohne Anführungszeichen!
}

// Monitoring-Scaffolding (Deaktiviert, um Warnungen bei manuellem Abbruch zu unterdrücken)
timeline { enabled = false }
report   { enabled = false }

trace {
    enabled = false      // Wird flexibel erst im projektspezifischen config-Zweig aktiviert
    file    = "pipeline_trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,cpus,time,memory,attempt,submit,start,complete,duration,realtime,workdir'
}

// Weitet work/ für inkrementelles -resume Caching aus
cleanup = false 

// ── Projekt-Skelett Parameter — Werden von der lokalen Pipeline überschrieben ──
params.project_name  = 'genericProject'
params.input_dir     = '../../../rawData'
params.output_dir    = '../../../results'
params.python_exe    = 'python3'
params.toolbox_dir   = '../../modules'
params.l2_analyses   = false