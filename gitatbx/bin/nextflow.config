// Generic Nextflow Configuration for Python-based Analysis Pipelines
// Works with python_dispatcher pattern and participant-based output directories
// Suitable for any multi-participant data analysis workflow

// Process configuration - optimized for python_dispatcher tasks
process {
    // Error handling: 'ignore' means failed processes are skipped (no output emitted)
    // but the workflow continues. Other branches and participants are not affected.
    // The finalizer uses groupTuple(size: N, remainder: true) to handle partial results.
    errorStrategy = { task.exitStatus in [137,140] ? 'retry' : 'ignore' }
    maxRetries = 3

    // Dynamic resource allocation - scales with retry attempts
    memory = { 2.GB * task.attempt }
    cpus = 2

    // Force file copy for staging to avoid symlink issues on Windows/WSL mounts
    stageInMode = 'copy'
    stageOutMode = 'copy'

    // Optional: Add conda/container support for reproducibility
    // conda = 'path/to/environment.yml'
    // container = 'your-analysis-container'
}

// Executor configuration - optimized for local multi-core execution
executor {
    name = 'local'
    cpus = 16           // Adjust to your system's cores
    memory = '31 GB'   // Adjust to your system's RAM
}

// Comprehensive pipeline monitoring and reporting
timeline {
    enabled = false                  // Disabled - not needed, causes warnings on manual termination
    file = "pipeline_timeline.html"
}

report {
    enabled = false                  // Disabled - not needed, causes warnings on manual termination
    file = "pipeline_report.html"
}

trace {
    enabled = false                  // Disabled in generic config — enabled per-project in project config
    file = "pipeline_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,env,workdir,scratch'
    // Note: 'script' field removed - it contains newlines that break trace parsing
}

// Logging configuration
log {
    level = 'INFO'
    file = "nextflow.log"            // Main execution log
}

// Default parameter values — projects override these in their own config.
// Set l2_analyses = true in project config if the workflow contains second-level (cross-participant) analyses.
params.l2_analyses = false
// Watch mode: when true, the pipeline watches input_dir for new participants arriving during the run.
// The pipeline runs continuously until interrupted (Ctrl+C); finalSync() handles the last git push.
params.watch = true
// Grace period (seconds) for finalization: after the last terminal result arrives for a participant,
// wait this long for any remaining results before finalizing with partial data.
// Covers the case where upstream failures prevent some result branches from ever running.
params.finalize_grace_sec = 30
// Optional channel exclusion for ICA — empty means use all channels (no edge rejection).
// Projects can override with a JSON array of channel names to drop before ICA fitting.
params.eeg_ica_exclude = ''

// Work directory management - useful for debugging and log access
cleanup = false                     // Set to true for production to save disk space

// Note: Per-participant completion is handled by watchdog threads in workflow_wrapper
// Git sync happens automatically when each participant's terminal processes complete

// ── Project-specific parameters — pre-filled by atbx init ─────────────────────
params.project_name  = 'myProject'
params.input_dir     = '../rawData'
params.output_dir    = '../results'
params.python_exe    = 'python3'
params.toolbox_dir   = '../AnalysisToolbox/Python'